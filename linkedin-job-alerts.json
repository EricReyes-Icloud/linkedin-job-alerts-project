    },
    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\n// Deduplica ofertas que aparecieron en más de una búsqueda dentro del mismo batch\nconst seen = new Set();\nconst result = [];\n\nfor (const entry of $input.all()) {\n  const item = entry.json;\n  const url = item.url || '';\n  const id_externo = url.split('?')[0];\n\n  if (!id_externo || seen.has(id_externo)) continue;\n  seen.add(id_externo);\n\n  result.push({\n    titulo: item.titulo || '',\n    empresa: item.empresa || '',\n    url: url,\n    id_externo: id_externo,\n    fecha_deteccion: new Date().toISOString(),\n  });\n}\n\nreturn result.map((o, index) => ({ json: o, pairedItem: index }));"
      },
