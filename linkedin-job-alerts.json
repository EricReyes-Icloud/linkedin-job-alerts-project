      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\nconst allOfertas = [];\n\nfor (const entry of $input.all()) {\n  const data = entry.json;\n  const titulos = data.titulo || [];\n  const empresas = data.empresa || [];\n  const urls = data.url || [];\n\n  titulos.forEach((titulo, i) => {\n    allOfertas.push({\n      titulo: titulo?.trim() || '',\n      empresa: empresas[i]?.trim() || '',\n      url: urls[i] || '',\n    });\n  });\n}\n\nreturn allOfertas.map(o => ({ json: o }));"
      },
